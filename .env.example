# قاعدة بيانات MySQL — من cPanel أنشئ قاعدة ومستخدماً وامنحه كل الصلاحيات،
# ثم ركّب الرابط بهذا الشكل (لاحظ بادئة اسم حساب cPanel قبل اسم القاعدة والمستخدم):
DATABASE_URL="mysql://cpaneluser_dbuser:PASSWORD@localhost:3306/cpaneluser_mohaseb"

# سلسلة عشوائية طويلة (يمكن توليدها بـ: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# يستخدمهما prisma/seed.ts لإنشاء أول حساب مدير (اختياري)
# SEED_ADMIN_EMAIL="agence.rozatour@gmail.com"
# SEED_ADMIN_PASSWORD="ChangeMe123!"

# إعدادات البريد لإرسال عروض الولاء (من cPanel → Email Accounts → Connect Devices)
# الباسورد = كلمة مرور حساب البريد offer@rozatour-booking.com
SMTP_HOST="rozatour-booking.com"
SMTP_PORT="465"
SMTP_USER="offer@rozatour-booking.com"
SMTP_PASS="بريد-الحساب-كلمة-المرور"
# SMTP_FROM="Roza Tour <offer@rozatour-booking.com>"
