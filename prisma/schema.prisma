generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- المستخدمون (موظفو الوكالة) ----------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // ADMIN | STAFF
  createdAt    DateTime @default(now())
  taskOrders   TaskOrder[]
}

// ---------- إعدادات الوكالة (سجل واحد) ----------
model Settings {
  id              Int      @id @default(1)
  agencyName      String   @default("ROZATOUR")
  agencyTagline   String   @default("") // سطر فرعي تحت الاسم في ترويسة المستندات
  agencyAddress   String   @default("")
  agencyPhone     String   @default("")
  agencyEmail     String   @default("")
  agencyWebsite   String   @default("")
  agencyRC        String   @default("") // رقم السجل التجاري (N° RC) لملفات الفيزا الرسمية
  logoPath        String?
  stampPath       String?
  letterheadColor String   @default("#1f3864") // لون اسم الوكالة والشريط في ورق الشركة
  defaultCurrency String   @default("DZD")
  reminderDaysAhead Int    @default(7)
  updatedAt       DateTime @updatedAt
}

// ---------- العملاء ----------
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  passport  String?  // رقم جواز السفر (اختياري — يُستعمل في الدعوات)
  // المرافقون (عائلة/أطفال) بدل تسجيلهم كعملاء مستقلين: [{ name, passport }]
  companions Json?
  notes     String? @db.Text
  createdAt DateTime @default(now())
  trips     Trip[]
  documents Document[]
  invoices  Invoice[]
}

// ---------- الفنادق ----------
model Hotel {
  id            String   @id @default(cuid())
  name          String
  city          String?
  phone         String?
  email         String?
  contactPerson String?
  notes         String? @db.Text
  createdAt     DateTime @default(now())
  bookings      HotelBooking[]
}

// ---------- المرشدون السياحيون ----------
model Guide {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  languages String?
  notes     String? @db.Text
  createdAt DateTime @default(now())
  taskOrders TaskOrder[]
}

// ---------- السائقون ----------
model Driver {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  vehicleInfo String?
  notes       String? @db.Text
  createdAt   DateTime @default(now())
  taskOrders  TaskOrder[]
}

// ---------- البرامج السياحية (القالب) ----------
model TourProgram {
  id                  String   @id @default(cuid())
  name                String
  description         String? @db.Text
  durationDays        Int
  standardPrice       Float // السعر المعروض للعميل (للفرد)
  estHotelCostPerNight Float   @default(0)
  estTransportCost    Float    @default(0)
  estGuideFee         Float    @default(0)
  estOtherCosts       Float    @default(0)
  currency            String   @default("DZD")
  itinerary           String? @db.Text // نص وصف البرنامج يوم بيوم
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  trips               Trip[]
  invitations         Invitation[]
}

// ---------- الرحلة الفعلية (تنفيذ برنامج لعميل بتاريخ محدد) ----------
model Trip {
  id            String   @id @default(cuid())
  program       TourProgram @relation(fields: [programId], references: [id])
  programId     String
  customer      Customer @relation(fields: [customerId], references: [id])
  customerId    String
  startDate     DateTime
  endDate       DateTime
  numPax        Int      @default(1)
  agreedPrice   Float    @default(0) // السعر الإجمالي المتفق عليه مع العميل
  currency      String   @default("DZD")
  status        String   @default("PLANNED") // PLANNED | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  notes         String? @db.Text
  createdAt     DateTime @default(now())

  hotelBookings  HotelBooking[]
  flightBookings FlightBooking[]
  otherBookings  OtherBooking[]
  transactions   Transaction[]
  taskOrders     TaskOrder[]
  documents      Document[]
  payments       Payment[]
  invoices       Invoice[]
  attachments    Attachment[]
}

// ---------- حجوزات الفنادق ----------
model HotelBooking {
  id                String   @id @default(cuid())
  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId            String
  hotel             Hotel    @relation(fields: [hotelId], references: [id])
  hotelId           String
  checkIn           DateTime?
  checkOut          DateTime?
  roomType          String?
  numRooms          Int      @default(1)
  cost              Float    @default(0)
  confirmationNumber String?
  notes             String? @db.Text
  createdAt         DateTime @default(now())
}

// ---------- حجوزات الطيران ----------
model FlightBooking {
  id               String   @id @default(cuid())
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId           String
  airline          String
  flightNumber     String?
  departureAirport String?
  arrivalAirport   String?
  departureDate    DateTime?
  arrivalDate      DateTime?
  cost             Float    @default(0)
  pnr              String?
  notes            String? @db.Text
  createdAt        DateTime @default(now())
}

// ---------- حجوزات أخرى (تأمين، نشاطات، مطاعم...) ----------
model OtherBooking {
  id          String   @id @default(cuid())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  type        String
  description String? @db.Text
  provider    String?
  cost        Float    @default(0)
  date        DateTime?
  notes       String? @db.Text
  createdAt   DateTime @default(now())
}

// ---------- القيود المحاسبية (إيرادات / مصروفات) ----------
model Transaction {
  id          String   @id @default(cuid())
  trip        Trip?    @relation(fields: [tripId], references: [id])
  tripId      String?
  // ربط اختياري بمستحقات الخدمات (رسوم الدعوة / رسوم فيزا الصحراء) لحذفها تلقائياً معها
  invitation       Invitation?      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  invitationId     String?
  visaApplication  VisaApplication? @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)
  visaApplicationId String?
  type        String   // INCOME | EXPENSE
  category    String
  amount      Float
  currency    String   @default("DZD")
  date        DateTime
  description String? @db.Text
  createdAt   DateTime @default(now())
}

// ---------- الميزانية الافتتاحية ----------
model OpeningBalance {
  id        String   @id @default(cuid())
  fiscalYear Int
  itemName  String
  itemType  String   // ASSET | LIABILITY | EQUITY
  amount    Float
  notes     String? @db.Text
  createdAt DateTime @default(now())
}

// ---------- أوامر التكليف بمهمة ----------
model TaskOrder {
  id           String   @id @default(cuid())
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId       String
  assigneeType String   // GUIDE | DRIVER
  guide        Guide?   @relation(fields: [guideId], references: [id])
  guideId      String?
  driver       Driver?  @relation(fields: [driverId], references: [id])
  driverId     String?
  taskDate     DateTime
  details      String? @db.Text
  createdBy    User?    @relation(fields: [createdById], references: [id])
  createdById  String?
  createdAt    DateTime @default(now())
}

// ---------- قوالب المستندات (يديرها المستخدم بنفسه) ----------
model DocumentTemplate {
  id        String   @id @default(cuid())
  name      String   // اسم القالب في القائمة، مثال: دعوة سياحية
  title     String   // عنوان المستند الظاهر في الـ PDF
  body      String   @db.Text // نص القالب مع متغيرات مثل [CLIENT] و [PROGRAM]
  style     Json?    // تنسيق افتراضي: حجم الخط، الألوان، تباعد الأسطر، الإطار...
  createdAt DateTime @default(now())
}

// ---------- المستندات الصادرة (دعوة سياحية، تصريح عمل، ...) ----------
model Document {
  id         String    @id @default(cuid())
  docNumber  String    // رقم تسلسلي مثل 2026/0001
  title      String
  body       String    @db.Text
  trip       Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripId     String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  showStamp  Boolean   @default(true)
  style      Json?     // تنسيق هذا المستند (يبدأ من تنسيق القالب ويعدَّل بحرية)
  docDate    DateTime  @default(now())
  createdAt  DateTime  @default(now())
}

// ---------- دفعات العملاء (سندات القبض) ----------
model Payment {
  id            String   @id @default(cuid())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId        String
  receiptNumber String   // رقم سند القبض، مثال: 2026/0001
  amount        Float
  method        String   @default("CASH") // CASH | BANK | CHEQUE | OTHER
  reference     String?  // رقم الشيك أو التحويل البنكي
  notes         String?  @db.Text
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())
}

// ---------- الفواتير ----------
model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    // رقم الفاتورة، مثال: 2026/0001
  trip          Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripId        String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  currency      String    @default("DZD")
  items         Json      // [{ description, qty, unitPrice }]
  discount      Float     @default(0)
  notes         String?   @db.Text
  showStamp     Boolean   @default(true)
  docDate       DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

// ---------- مرفقات الرحلات (جوازات، تذاكر، تأكيدات...) ----------
model Attachment {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  label     String   // وصف الملف، مثال: جواز سفر العميل
  path      String   // /uploads/attachments/xxx.pdf
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------- طلبات الفيزا الصحراوية ----------
model VisaApplication {
  id           String   @id @default(cuid())
  refNumber    String   // رقم مرجعي 2026/0001
  wilaya       String   // ولاية مديرية السياحة الموجه إليها الملف
  wilayasConcernees String @default("") // الولايات المعنية بالبرنامج
  arrivalDate  DateTime
  departureDate DateTime
  programDetail String  @db.Text // تفاصيل البرنامج يوم بيوم (يُملأ في ملف الوورد)
  notes        String?  @db.Text
  // رسم الخدمة لكل مسافر (يُسجَّل كإيراد تلقائياً عند الإنشاء)
  feePerPerson Float    @default(40)
  feeCurrency  String   @default("USD")
  createdAt    DateTime @default(now())
  travelers    VisaTraveler[]
  transactions Transaction[]
}

// الدعوات (مستند مدفوع مستقل): طلب موافقة على فيزا موجَّه لقنصلية لعدة أشخاص
model Invitation {
  id            String   @id @default(cuid())
  refNumber     String   // 2026/0001
  language      String   @default("fr") // ar | fr | en
  consulate     String   @default("")
  // المقدّم الأساسي + المرافقون: [{ name, passport }] وأولهم المقدّم الأساسي
  people        Json
  program       TourProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId     String?
  itinerary     String?  @db.Text // مخطط الرحلة (يُنسخ من البرنامج أو يُحرَّر)
  arrivalDate   DateTime?
  departureDate DateTime?
  fee           Float    @default(20) // رسم الدعوة (يُسجَّل كإيراد تلقائياً)
  feeCurrency   String   @default("USD")
  notes         String?  @db.Text
  docDate       DateTime @default(now())
  createdAt     DateTime @default(now())
  transactions  Transaction[]
}

model VisaTraveler {
  id              String   @id @default(cuid())
  application     VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  nom             String   // اللقب (كما في الجواز)
  prenom          String   // الاسم
  dateNaissance   DateTime?
  lieuNaissance   String   @default("")
  lieuResidence   String   @default("")
  typePasseport   String   @default("Passeport ordinaire")
  numeroPasseport String
  dateDelivrance  DateTime?
  dateExpiration  DateTime?
  nationalite     String   @default("")
  visaAnterieur   Boolean  @default(false)
  visaEmission    DateTime?
  visaExpirationA DateTime?
  createdAt       DateTime @default(now())
}
